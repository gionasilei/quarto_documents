
@article{zangetal,
	title = {The Relationship Between Math Anxiety and Math Performance: A Meta-Analytic Investigation},
	volume = {10},
	issn = {1664-1078},
	url = {https://www.frontiersin.org/journals/psychology/articles/10.3389/fpsyg.2019.01613/full},
	doi = {10.3389/fpsyg.2019.01613},
	shorttitle = {The Relationship Between Math Anxiety and Math Performance},
	abstract = {Math anxiety ({MA}) has been suggested to decrease the math performance of students. However, it remains unclear what factors moderate this relationship. The purpose of this study was to analyze the link between {MA} and math performance. Studies that explored the relationship between {MA} and math performance, conducted from 2000 to 2019 (84 samples, N = 8680), were identified and statistically integrated with a meta-analysis method. The results indicated a robust negative correlation between {MA} and math performance. Furthermore, regarding the analysis of moderator variables, this negative link was stronger in the studies that involved Asian students, whereas it was the weakest in the studies that involved European students. Moreover, this negative link was stronger in the studies within a senior high school group, whereas it was the weakest in the studies within an elementary group. Finally, this negative link was strongest among studies that used a custom test and studies that assessed problem-solving skills. Potential explanations and implications for research and practice are discussed.},
	journaltitle = {Frontiers in Psychology},
	shortjournal = {Front. Psychol.},
	publisher = {Frontiers},
	author = {Zhang, Jing and Zhao, Nan and Kong, Qi Ping},
	urldate = {2026-11-25},
	date = {2019-08-07},
	keywords = {Math Anxiety, math performance, Meta-analysis, Moderator analysis, Students},
	file = {Full Text PDF:/Users/gionasilei/Zotero/storage/LE5N78NT/Zhang et al. - 2019 - The Relationship Between Math Anxiety and Math Performance A Meta-Analytic Investigation.pdf:application/pdf},
}

@article{foleyetal,
	title = {The Math Anxiety-Performance Link: A Global Phenomenon},
	volume = {26},
	issn = {0963-7214},
	url = {https://doi.org/10.1177/0963721416672463},
	doi = {10.1177/0963721416672463},
	shorttitle = {The Math Anxiety-Performance Link},
	abstract = {Demand for science, technology, engineering, and mathematics ({STEM}) professionals is on the rise worldwide. To effectively meet this demand, many governments and private organizations have revamped {STEM} education and promoted training to enhance math and science skills among students and workers. Education and training programs typically focus on increasing individuals’ math and science knowledge. However, data from laboratory studies and large-scale international assessments suggest that fear or apprehension about math, math anxiety, should also be considered when trying to increase math achievement and, in turn, {STEM} career success. This article reviews findings that shed light on antecedents of math anxiety, the bidirectional math anxiety-performance relation, underlying mechanisms, and promising routes to mitigating the negative relation between math anxiety and math performance.},
	pages = {52--58},
	number = {1},
	journaltitle = {Current Directions in Psychological Science},
	shortjournal = {Curr Dir Psychol Sci},
	publisher = {{SAGE} Publications Inc},
	author = {Foley, Alana E. and Herts, Julianne B. and Borgonovi, Francesca and Guerriero, Sonia and Levine, Susan C. and Beilock, Sian L.},
	urldate = {2026-11-25},
	date = {2017-02-01},
	file = {Full Text PDF:/Users/gionasilei/Zotero/storage/43ZD3W2I/Foley et al. - 2017 - The Math Anxiety-Performance Link A Global Phenomenon.pdf:application/pdf},
}
